## Environment variables required for local development

# Gemini API key for AI-assisted features.
GEMINI_API_KEY=your-gemini-api-key-here

# Supabase connection.
# Copy these from Supabase Dashboard > Project Settings > API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Supabase Storage buckets created by supabase/schema.sql.
VITE_SUPABASE_IMAGES_BUCKET=sobkru-images
VITE_SUPABASE_SLIPS_BUCKET=sobkru-slips
VITE_SUPABASE_FILES_BUCKET=sobkru-files

# Server-only email campaign settings for Vercel API routes.
# Do not prefix these with VITE_ because SMTP secrets must never be bundled into the browser.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@your-domain.com
SMTP_PASS=your-hostinger-email-password
EMAIL_FROM=no-reply@your-domain.com
EMAIL_FROM_NAME=SobKru69
EMAIL_REPLY_TO=support@your-domain.com
EMAIL_CAMPAIGN_ADMIN_TOKEN=change-this-to-a-long-random-secret
EMAIL_BATCH_SIZE=40
EMAIL_MAX_RECIPIENTS_PER_REQUEST=3000
EMAIL_BATCH_DELAY_MS=250

# Legacy Google Apps Script values are no longer required after Supabase migration.
