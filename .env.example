## Environment variables required for local development

# Gemini API key for AI-assisted features.
GEMINI_API_KEY=your-gemini-api-key-here

# Supabase connection.
# Copy these from Supabase Dashboard > Project Settings > API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
# Server-only key for Vercel API routes that write email history. Never expose this as VITE_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Supabase Storage buckets created by supabase/schema.sql.
VITE_SUPABASE_IMAGES_BUCKET=sobkru-images
VITE_SUPABASE_SLIPS_BUCKET=sobkru-slips
VITE_SUPABASE_FILES_BUCKET=sobkru-files

# Server-only email campaign settings for Vercel API routes.
# Do not prefix these with VITE_ because SMTP secrets must never be bundled into the browser.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@your-domain.com
SMTP_PASS=your-hostinger-email-password
EMAIL_FROM=no-reply@your-domain.com
EMAIL_FROM_NAME=SobKru69
EMAIL_REPLY_TO=support@your-domain.com
EMAIL_CAMPAIGN_ADMIN_TOKEN=change-this-to-a-long-random-secret
# Hostinger/MailChannels blocks bulk BCC easily. Keep individual delivery enabled.
EMAIL_DELIVERY_MODE=individual
EMAIL_MAX_RECIPIENTS_PER_REQUEST=80
EMAIL_BATCH_SIZE=10
EMAIL_BATCH_DELAY_MS=500
EMAIL_MESSAGE_ID_DOMAIN=your-domain.com
EMAIL_UNSUBSCRIBE_URL=https://your-domain.com/
SMTP_POOL=true
SMTP_MAX_CONNECTIONS=1
SMTP_MAX_MESSAGES=100

# Server-only Inbox settings for reading replies from contact@coolcom.click via IMAP.
# Use the exact incoming mail values from your Hostinger mailbox settings.
IMAP_HOST=imap.your-mail-host.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=contact@coolcom.click
IMAP_PASS=your-hostinger-email-password
EMAIL_INBOX_ADMIN_TOKEN=change-this-to-a-long-random-secret
EMAIL_INBOX_LIMIT=25

# Legacy Google Apps Script values are no longer required after Supabase migration.
